# ==============================================================================
# OpenAgriNet Master Data Management (MDM) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Network & Docker Settings
# ------------------------------------------------------------------------------
DOCKER_NETWORK=farmer-registry_default
CATALOG_API_PORT=8002
CATALOG_UI_PORT=3002
STAFF_PORTAL_WORKERS=2

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL 14+ with uuid-ossp extension)
# ------------------------------------------------------------------------------
POSTGRES_HOST=farmer-registry-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=catalog_registry_db

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=farmer-registry-minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminsecret
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Redis Cache
# ------------------------------------------------------------------------------
REDIS_URL=redis://farmer-registry-redis:6379/0

# ------------------------------------------------------------------------------
# Keycloak IAM Settings (Optional for read-only APIs; needed for Staff UI login)
# ------------------------------------------------------------------------------
AUTH_ENABLED=false
IAM_API_URL=http://farmer-registry-iam-staff-api:8000
KEYCLOAK_LOGOUT_URL=http://localhost:8080/realms/staff/protocol/openid-connect/logout
COOKIE_DOMAIN=localhost
STAFF_UI_REDIRECT_URL=http://localhost:3002
